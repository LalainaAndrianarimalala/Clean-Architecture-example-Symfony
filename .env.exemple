

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=your-secret-key-here
APP_DEBUG=1
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/mailer ###
MAILER_DSN=
###< symfony/mailer ###

###> symfony/messenger ###
# Transport async (ex: doctrine, redis, rabbitmq)
MESSENGER_TRANSPORT_DSN=doctrine://default
###< symfony/messenger ###

###> symfony/cache ###
CACHE_APP=
###< symfony/cache ###

###> symfony/session ###
SESSION_HANDLER=
###< symfony/session ###

###> cors ###
CORS_ALLOW_ORIGIN=*
###< cors ###

###> api_platform ###
API_PLATFORM_ENABLE_SWAGGER=true
###< api_platform ###

###> custom variables ###
APP_NAME="Franken PHP  Symfony"
###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###
# REDIS HOST
REDIS_HOST=redis
###< custom variables ###
# customize this line!
DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/timesheet?serverVersion=8.0.37"

###> redis_url ###
REDIS_URL=
###> redis_url ###

# to use mariadb:
# DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/db_name?serverVersion=10.5.8-MariaDB"

# to use sqlite:
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/app.db"

# to use postgresql:
# DATABASE_URL="postgresql://db_user:db_password@127.0.0.1:5432/db_name?serverVersion=12.19 (Debian 12.19-1.pgdg120+1)&charset=utf8"

# to use oracle:
# DATABASE_URL="oci8://db_user:db_password@127.0.0.1:1521/db_name"

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=votre_mot_de_passe
###< lexik/jwt-authentication-bundle ###
